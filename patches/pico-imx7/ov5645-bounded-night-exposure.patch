+
+static int ov5645_apply_night_exposure(struct ov5645 *sensor)
+{
+	enum {
+		BIT_MODE, SYSTEM_DIV, MULTIPLIER, PLL_DIV, SCLK_DIV,
+		HTS_HIGH, HTS_LOW, LIMIT50_HIGH, AEC_CONTROL,
+	};
+	static const u16 registers[] = {
+		0x3034, 0x3035, 0x3036, 0x3037, 0x3108,
+		0x380c, 0x380d, 0x3a14, 0x3a00,
+	};
+	static const unsigned int sclk_dividers[] = { 1, 2, 4, 8 };
+	u8 values[ARRAY_SIZE(registers)];
+	unsigned int bit_div2x, system_div, pre_div, pll_div, hts;
+	u64 sysclk, lines;
+	int i, ret;
+
+	if (!night_max_exposure_ms)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(registers); i++) {
+		ret = ov5645_read_reg(sensor, registers[i], &values[i]);
+		if (ret < 0)
+			return -EIO;
+	}
+
+	bit_div2x = values[BIT_MODE] & 0x0f;
+	if (bit_div2x != 8 && bit_div2x != 10)
+		return -EINVAL;
+	bit_div2x /= 2;
+	system_div = values[SYSTEM_DIV] >> 4;
+	if (!system_div)
+		system_div = 16;
+	pre_div = values[PLL_DIV] & 0x0f;
+	if (pre_div != 1 && pre_div != 2 && pre_div != 3 &&
+	    pre_div != 4 && pre_div != 6 && pre_div != 8)
+		return -EINVAL;
+	pll_div = ((values[PLL_DIV] >> 4) & 1) + 1;
+	hts = ((unsigned int)values[HTS_HIGH] << 8) | values[HTS_LOW];
+	if (!hts || !values[MULTIPLIER])
+		return -EINVAL;
+
+	// Match OV5645_get_sysclk's 10 kHz units and divider order.
+	sysclk = div_u64((u64)(sensor->mclk / 10000) * values[MULTIPLIER], pre_div);
+	sysclk = div_u64(sysclk, system_div);
+	sysclk = div_u64(sysclk, pll_div);
+	sysclk = div_u64(sysclk * 2, bit_div2x);
+	sysclk = div_u64(sysclk, sclk_dividers[values[SCLK_DIV] & 3]);
+	if (!sysclk)
+		return -EINVAL;
+	lines = div_u64(sysclk * 10 * night_max_exposure_ms, hts);
+	if (!lines)
+		return -ERANGE;
+	// OV5645 specification 2.01 table 7-7: the 50 Hz limit is 12 bits.
+	lines = min_t(u64, lines, 0x0fff);
+
+	ret = ov5645_write_reg(sensor, 0x3a02, lines >> 8);
+	if (ret)
+		return ret;
+	ret = ov5645_write_reg(sensor, 0x3a03, lines & 0xff);
+	if (ret)
+		return ret;
+	ret = ov5645_write_reg(sensor, 0x3a14,
+				   (values[LIMIT50_HIGH] & 0xf0) | (lines >> 8));
+	if (ret)
+		return ret;
+	ret = ov5645_write_reg(sensor, 0x3a15, lines & 0xff);
+	if (ret)
+		return ret;
+	return ov5645_write_reg(sensor, 0x3a00, values[AEC_CONTROL] | BIT(2));
 }
 
