+// Opt-in exposure extension; the default retains the vendor frame timing.
+static unsigned int night_max_exposure_ms;
+
+static int ov5645_set_night_max_exposure(const char *value,
+				       const struct kernel_param *param)
+{
+	unsigned int milliseconds;
+	int ret;
+
+	ret = kstrtouint(value, 0, &milliseconds);
+	if (ret)
+		return ret;
+	if (milliseconds > 130)
+		return -ERANGE;
+	*(unsigned int *)param->arg = milliseconds;
+	return 0;
+}
+
+static const struct kernel_param_ops ov5645_night_exposure_ops = {
+	.set = ov5645_set_night_max_exposure,
+	.get = param_get_uint,
+};
+module_param_cb(night_max_exposure_ms, &ov5645_night_exposure_ops,
+	       &night_max_exposure_ms, 0444);
+MODULE_PARM_DESC(night_max_exposure_ms,
+		"Automatic night exposure ceiling in ms (0 disables; maximum 130)");
 
