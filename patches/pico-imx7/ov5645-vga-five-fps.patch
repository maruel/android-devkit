+static int ov5645_select_frame_rate(const struct v4l2_fract *interval,
+				    enum ov5645_frame_rate *rate)
+{
+	unsigned int i;
+
+	if (!interval->numerator || !interval->denominator)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(ov5645_framerates); i++) {
+		if ((u64)interval->numerator * ov5645_framerates[i] ==
+		    interval->denominator) {
+			*rate = i;
+			return 0;
+		}
+	}
+	return -EINVAL;
+}
