+static int ov5645_apply_night_exposure(struct ov5645 *sensor)
+{
+	u8 limit50_high, aec_control;
+	unsigned int hts;
+	u64 sysclk, lines;
+	int ret;
+
+	if (!night_max_exposure_ms)
+		return 0;
+	ret = ov5645_get_timing(sensor, &sysclk, &hts);
+	if (ret)
+		return ret;
+	if (ov5645_read_reg(sensor, 0x3a14, &limit50_high) < 0 ||
+	    ov5645_read_reg(sensor, 0x3a00, &aec_control) < 0)
+		return -EIO;
 	lines = div_u64(sysclk * 10 * night_max_exposure_ms, hts);
 	if (!lines)
