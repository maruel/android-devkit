+static int ov5645_apply_frame_rate(struct ov5645 *sensor, enum ov5645_frame_rate rate)
+{
+	unsigned int hts;
+	u64 sysclk, vts;
+	int ret;
+
+	if (rate != ov5645_5_fps)
+		return 0;
+	ret = ov5645_get_timing(sensor, &sysclk, &hts);
+	if (ret)
+		return ret;
+	// Round up to a complete line; retain the VGA PLL and MIPI clocks.
+	vts = DIV_ROUND_UP_ULL(sysclk * 10000, (u64)hts * 5);
+	if (vts <= sensor->pix.height + 4 || vts > 0xffff)
+		return -ERANGE;
+	ret = ov5645_write_reg(sensor, 0x380e, vts >> 8);
+	if (ret)
+		return ret;
+	return ov5645_write_reg(sensor, 0x380f, vts & 0xff);
 }
 
